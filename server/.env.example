PORT=4003
CLIENT_URL=http://localhost:5173

MONGO_URI=mongodb://127.0.0.1:27017/cdk-team

JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=8h

# Compte admin unique — utilisé par `npm run seed`
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me

# Nodemailer (SMTP) — pour la réinitialisation de mot de passe
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="CDK-Team <no-reply@example.com>"

# Base publique du site, utilisée dans le lien de réinitialisation envoyé par email
PUBLIC_APP_URL=http://localhost:5173

# Taille maximale d un PDF televerse, en megaoctets. Doit rester SOUS le
# `client_max_body_size` du vhost Nginx (220 Mo) : au-dessus, Nginx coupe la
# requête en 413 avant que l'API n'ait pu répondre quoi que ce soit d'utile.
PDF_MAX_SIZE_MB=200
