# Copier ce fichier vers deployment/.env sur le VPS (jamais commité) et
# remplir les vraies valeurs. Ce fichier sert à deux choses :
#   1. env_file du service "server" dans docker-compose.yml
#   2. variables lues par deploy.sh (notamment VITE_API_URL pour le build client)
#
# Différences avec server/.env.example (pensé pour du dev local sans Docker) :
#   - MONGO_URI pointe vers le service compose "mongo" (pas 127.0.0.1), avec
#     les identifiants MONGO_ROOT_USER/PASSWORD définis ci-dessous
#   - CLIENT_URL / PUBLIC_APP_URL pointent vers le vrai domaine public
#   - VITE_API_URL (nouveau, utilisé uniquement par deploy.sh) pointe vers
#     l'URL publique de l'API telle que le navigateur doit la voir

PORT=4003
CLIENT_URL=https://DOMAINE_A_DEFINIR
PUBLIC_APP_URL=https://DOMAINE_A_DEFINIR

# Identifiants Mongo (utilisés à la fois par le service mongo et dans MONGO_URI)
MONGO_ROOT_USER=changeme
MONGO_ROOT_PASSWORD=changeme
MONGO_URI=mongodb://changeme:changeme@mongo:27017/cdk-team?authSource=admin

# openssl rand -hex 32
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=8h

# Compte admin unique — utilisé par `./deploy.sh seed` (une seule fois)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me

# Nodemailer (SMTP) — pour la réinitialisation de mot de passe
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="CDK-Team <no-reply@example.com>"

# Utilisé uniquement par deploy.sh au build du client (Vite inline cette
# valeur dans le JS — tout changement exige un rebuild client complet)
VITE_API_URL=https://DOMAINE_A_DEFINIR/api

# Taille maximale d un PDF televerse, en megaoctets. Doit rester SOUS le
# `client_max_body_size` du vhost Nginx (220 Mo) : au-dessus, Nginx coupe la
# requête en 413 avant que l'API n'ait pu répondre quoi que ce soit d'utile.
PDF_MAX_SIZE_MB=200
